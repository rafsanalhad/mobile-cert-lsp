{
  "expo": {
    "name": "Agenda Nusantara",
    "slug": "AgendaNusantara",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ptsdm.agendanusantara"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.ptsdm.agendanusantara",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      [
        "expo-sqlite"
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f82d344a-ddc2-4bf5-9cec-67340686e1ab"
      }
    },
    "owner": "rafsanalhad"
  }
}
